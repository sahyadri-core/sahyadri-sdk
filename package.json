{
  "name": "@sahyadrinet/web3.js",
  "version": "0.1.1",
  "description": "Sahyadri L1 Blockchain SDK - Post-Quantum Secure Web3 Library",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "test": "npx tsx test-full.ts"
  },
  "keywords": [
    "sahyadri",
    "blockchain",
    "web3",
    "post-quantum",
    "dilithium",
    "ml-dsa",
    "crypto"
  ],
  "author": "Sahyadri Network",
  "license": "MIT",
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@noble/post-quantum": "^0.7.1",
    "@scure/base": "^1.2.6"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sahyadrinet/sahyadri-sdk.git"
  }
}
